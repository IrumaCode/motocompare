# Copy this file to .env and adjust values if needed. Never commit .env.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=motocompare
POSTGRES_PASSWORD=motocompare
POSTGRES_DB=motocompare
POSTGRES_PORT=5432

# Connection string used by Prisma (CLI and client). Must match the values above.
DATABASE_URL="postgresql://motocompare:motocompare@localhost:5432/motocompare?schema=public"

# Separate database for the API integration tests (`pnpm test:db`). They wipe it on every run,
# so its name must end in "_test". Same Docker server; Prisma creates the database if missing.
TEST_DATABASE_URL="postgresql://motocompare:motocompare@localhost:5432/motocompare_test?schema=public"

# GraphQL API (optional, defaults to 4000)
PORT=4000

# Web origins allowed to call the API from a browser, comma-separated (optional).
# Leave unset in development (any origin). In production, set it to the web app's domain(s).
# CORS_ORIGINS=https://motocompare.sneyderla.dev,https://motocompare.pages.dev

# Web app: GraphQL endpoint (optional). Leave unset in development: Vite proxies /graphql
# to the local API. Set it only when the API lives on another domain (production).
# VITE_API_URL=https://api.example.com/graphql
